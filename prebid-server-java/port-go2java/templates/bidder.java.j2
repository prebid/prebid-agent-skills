{# Multiformat guard (Teal #4765). A multiformat adapter can receive an imp
   carrying more than one media type at once (e.g. banner+video), so imp-only
   resolution (fixed video>native>audio>banner priority) cannot tell which
   format a returned bid is for and mis-types every non-first bid. The
   authoritative per-bid signal is bid.getMtype(); such an adapter MUST use
   bid_type_resolution=="by-bid-mtype". Fail loudly at render if an imp-only
   resolution is selected for a multiformat adapter (mirrors the Go template
   guard; Java has no vouching surface to excuse a silent constant). #}
{%- if (ctx.multiformat_supported | default(false)) and ctx.bid_type_resolution == "imp-mediatype-introspection" -%}
{{ {}.multiformat_adapter_must_use_by_bid_mtype_resolution.fail }}
{%- endif -%}
{# Tolerance guard (F-new-108). "per-bid-skip" threads an errors list through
   extractBids and returns null for an unresolved type; only the by-bid-mtype
   resolution has that null-means-skip contract -- every other arm returns a
   BidType unconditionally, so the null branch would be unreachable and the
   errors parameter unused (checkstyle would flag it). Any other pairing is a
   context-assembly bug, so fail at render rather than emit it. #}
{%- if (ctx.bid_type_error_tolerance | default("abort-all")) == "per-bid-skip" and ctx.bid_type_resolution != "by-bid-mtype" -%}
{{ {}.per_bid_skip_tolerance_requires_by_bid_mtype_resolution.fail }}
{%- endif -%}
{% if ctx.bid_type_error_tolerance == "per-bid-skip" %}
    private BidType resolveBidType(Bid bid, List<BidderError> errors) {
{% else %}
    private BidType resolveBidType(Bid bid, BidRequest bidRequest) {
{% endif %}
{% if ctx.bid_type_resolution == "constant-banner" %}
        return BidType.banner;
{% elif ctx.bid_type_resolution == "by-bid-mtype" %}
{% if ctx.bid_type_error_tolerance == "per-bid-skip" %}
        // Rule 23 — classify by the response's own bid.mtype (OpenRTB 2.6:
        // 1=banner, 2=video, 3=audio, 4=native). Per-bid tolerance
        // (F-new-108): an unresolved mtype surfaces badServerResponse and
        // SKIPS this bid; sibling bids in the same response continue, which
        // mirrors the Go `errs = append(errs, err); continue` loop.
        return switch (bid.getMtype()) {
            case 1 -> BidType.banner;
            case 2 -> BidType.video;
            case 3 -> BidType.audio;
            case 4 -> BidType.xNative;
            case null, default -> {
                errors.add(BidderError.badServerResponse(
                        "Unsupported bid.mtype " + bid.getMtype() + " for impId: " + bid.getImpid()));
                yield null;
            }
        };
{% else %}
        // Rule 23 — classify by the response's own bid.mtype (OpenRTB 2.6:
        // 1=banner, 2=video, 3=audio, 4=native). Authoritative for multiformat
        // imps where a single imp carries co-present formats. Unresolved mtype
        // surfaces an error rather than silently defaulting to banner.
        final Integer mType = bid.getMtype();
        if (mType == null) {
            throw new PreBidException(
                    "Missing bid.mtype for bid with impId: " + bid.getImpid());
        }
        return switch (mType) {
            case 1 -> BidType.banner;
            case 2 -> BidType.video;
            case 3 -> BidType.audio;
            case 4 -> BidType.xNative;
            default -> throw new PreBidException(
                    "Unsupported bid.mtype " + mType + " for impId: " + bid.getImpid());
        };
{% endif %}
{% elif ctx.bid_type_resolution == "imp-mediatype-introspection" %}
        // Walk bid.impid → matching imp; classify by populated mediatype field.
        for (Imp imp : bidRequest.getImp()) {
            if (Objects.equals(imp.getId(), bid.getImpid())) {
                if (imp.getVideo() != null) {
                    return BidType.video;
                }
                if (imp.getXNative() != null) {
                    return BidType.xNative;
                }
                if (imp.getAudio() != null) {
                    return BidType.audio;
                }
                return BidType.banner;
            }
        }
        return BidType.banner;
{% elif ctx.bid_type_resolution == "ext-prebid-video-placement" %}
        // Inspect bid.ext.prebid.type when present; fallback to imp introspection.
        final JsonNode extPrebid = bid.getExt() != null
                ? bid.getExt().get("prebid")
                : null;
        if (extPrebid != null && extPrebid.get("type") != null) {
            try {
                return BidType.valueOf(extPrebid.get("type").asText());
            } catch (IllegalArgumentException ignored) {
                // fall through
            }
        }
        for (Imp imp : bidRequest.getImp()) {
            if (Objects.equals(imp.getId(), bid.getImpid())) {
                return imp.getVideo() != null ? BidType.video : BidType.banner;
            }
        }
        return BidType.banner;
{% else %}
        // TODO[port-go2java]: bid_type_resolution={{ ctx.bid_type_resolution }}
        // requires per-bidder customization (Rule 23-25).
        return BidType.banner;
{% endif %}
    }
{% if ctx.batching_kind == "max-imps-per-request" %}

    private static List<List<Imp>> chunkImps(List<Imp> imps, int chunkSize) {
        final List<List<Imp>> chunks = new ArrayList<>();
        for (int i = 0; i < imps.size(); i += chunkSize) {
            chunks.add(imps.subList(i, Math.min(i + chunkSize, imps.size())));
        }
        return chunks;
    }
{% endif %}
