    @Override
    public Result<List<BidderBid>> makeBids(BidderCall<BidRequest> httpCall, BidRequest bidRequest) {
{% if ctx.http_status_kind == "canonical-helpers" %}
        // Rule 30 (canonical-helpers): no explicit status check — Java's HTTP
        // layer handles 204 NO_CONTENT and non-200 codes before makeBids is
        // invoked (matches upstream KoblerBidder; framework-default pattern).
{% else %}
        final HttpResponse response = httpCall.getResponse();
        if (response.getStatusCode() == 204) {
            return Result.empty();
        }
        if (response.getStatusCode() != 200) {
            return Result.withError(BidderError.badServerResponse(
                    "Unexpected status code: " + response.getStatusCode()));
        }
{% endif %}
        try {
            final BidResponse bidResponse = mapper.decodeValue(httpCall.getResponse().getBody(), BidResponse.class);
{% if ctx.bid_type_error_tolerance == "per-bid-skip" %}
            final List<BidderError> errors = new ArrayList<>();
            return Result.of(extractBids(bidResponse, errors), errors);
{% else %}
            return Result.withValues(extractBids(bidResponse, bidRequest));
{% endif %}
        } catch (DecodeException e) {
            return Result.withError(BidderError.badServerResponse(e.getMessage()));
        }
    }

    private ExtImp{{ ctx.imp_ext_class_root }} parseImpExt(Imp imp) {
        try {
{% if ctx.imp_ext_unmarshal_kind == "standard-two-phase" %}
            return mapper.mapper()
                    .convertValue(imp.getExt(), {{ ctx.bidder_class_root | upper }}_EXT_TYPE_REFERENCE)
                    .getBidder();
{% else %}
            return mapper.mapper()
                    .convertValue(imp.getExt(), ExtImp{{ ctx.imp_ext_class_root }}.class);
{% endif %}
        } catch (IllegalArgumentException e) {
            throw new PreBidException(
                    "Could not parse imp.ext.bidder for imp.id=" + imp.getId() + ": " + e.getMessage());
        }
    }

    private String resolveEndpoint(BidRequest bidRequest) {
{% if ctx.endpoint_resolution_kind == "static" %}
        return endpointUrl;
{% elif ctx.endpoint_resolution_kind == "dev-prod-toggle" %}
        // Rule 13 — dev-prod-toggle. Upstream pattern (e.g., kobler):
        //   isTest(imps.getFirst(), errors) ? devEndpoint : endpointUrl
        // Requires: typed-config field `devEndpoint` (Rule 35), isTest helper
        // that reads imp.ext.bidder.test or imp.ext.test boolean.
        // TODO[port-go2java]: implement isTest(Imp) and add `devEndpoint` field
        // to the bidder class constructor (from {{ ctx.bidder_class_root }}BidderConfigurationProperties).
        return endpointUrl;
{% elif ctx.endpoint_resolution_kind == "template-macro" %}
        // Rule 11 — single-macro template substitution. Upstream pattern uses
        // String.format on a per-imp macro value extracted from imp.ext.bidder.
        // Macros declared in source spec: {{ ctx.endpoint_macros | default('see spec') }}.
        // TODO[port-go2java]: extract the macro value from imp.ext.bidder
        // (typically imp.ext.bidder.{PublisherID|SupplyId|etc.}) and substitute
        // into endpointUrl via String.format("...", value) or .replace("{{ '{{' }}MACRO{{ '}}' }}", value).
        return endpointUrl;
{% elif ctx.endpoint_resolution_kind == "multi-token-substitution" %}
        // Rule 11 EXT — multi-token endpoint substitution. Source spec
        // declares N macro fields requiring chained substitution.
        // TODO[port-go2java]: extract each macro field from imp.ext.bidder
        // and chain .replace("{{ '{{' }}TOKEN{{ '}}' }}", value) calls, or use String.format
        // with positional args. See source spec's macro_field_set for the
        // ordered list of tokens.
        return endpointUrl;
{% elif ctx.endpoint_resolution_kind == "query-parameter-augmentation" %}
        // Rule 12 — query-parameter augmentation. Source builds the URL by
        // appending ?key=value pairs derived from imp.ext.bidder fields.
        // Upstream Java pattern: org.apache.http.client.utils.URIBuilder
