        //   return bid.toBuilder()
        //           .nurl(replaceMacro(bid.getNurl(), "${AUCTION_PRICE}", priceStr))
        //           .adm(replaceMacro(bid.getAdm(), "${AUCTION_PRICE}", priceStr))
        //           .burl(replaceMacro(bid.getBurl(), "${AUCTION_PRICE}", priceStr))
        //           .build();
        return bid;
    }
