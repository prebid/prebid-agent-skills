                .filter(Objects::nonNull)
                .flatMap(List::stream)
{% if ctx.has_bid_post_processing_macros %}
                .map(this::applyBidPostProcessingMacros)
{% endif %}
                .map(bid -> BidderBid.of(bid, resolveBidType(bid, bidRequest), bidResponse.getCur()))
                .toList();
