        // TODO[port-go2java]: extract per-imp query params from imp.ext.bidder
        // and append to endpointUrl. Watch for HttpUtil.validateUrl rejection
        // of malformed URLs (Rule 12 also requires url.ParseRequestURI parity).
        return endpointUrl;
{% else %}
        // TODO[port-go2java]: endpoint_resolution_kind={{ ctx.endpoint_resolution_kind }}
        // requires per-bidder customization (Rule 11/12/13/14).
        return endpointUrl;
{% endif %}
    }

{% if ctx.bid_type_error_tolerance == "per-bid-skip" %}
{# F-new-108. Per-bid tolerance: resolveBidType returns null for an unresolved
   mtype instead of throwing, so the stream filters that bid out and its
   siblings survive. Target-repo shape: ZentotemBidder (errors list threaded
   through extractBids -> makeBidderBid -> the type resolver). #}
    private List<BidderBid> extractBids(BidResponse bidResponse, List<BidderError> errors) {
        if (bidResponse == null || bidResponse.getSeatbid() == null) {
            return Collections.emptyList();
        }
        return bidResponse.getSeatbid().stream()
                .filter(Objects::nonNull)
                .map(SeatBid::getBid)
                .filter(Objects::nonNull)
                .flatMap(List::stream)
                .filter(Objects::nonNull)
{% if ctx.has_bid_post_processing_macros %}
                .map(this::applyBidPostProcessingMacros)
{% endif %}
                .map(bid -> makeBidderBid(bid, bidResponse.getCur(), errors))
                .filter(Objects::nonNull)
                .toList();
    }

    private BidderBid makeBidderBid(Bid bid, String currency, List<BidderError> errors) {
        final BidType bidType = resolveBidType(bid, errors);
        return bidType != null
                ? BidderBid.of(bid, bidType, currency)
                : null;
    }
{% else %}
    private List<BidderBid> extractBids(BidResponse bidResponse, BidRequest bidRequest) {
