    @Override
    public Result<List<BidderBid>> makeBids(BidderCall<BidRequest> httpCall, BidRequest bidRequest) {
{% if ctx.http_status_kind == "canonical-helpers" %}
        // Rule 30 (canonical-helpers): no explicit status check — Java's HTTP
        // layer handles 204 NO_CONTENT and non-200 codes before makeBids is
        // invoked (matches upstream KoblerBidder; framework-default pattern).
{% else %}
        final HttpResponse response = httpCall.getResponse();
        if (response.getStatusCode() == 204) {
            return Result.empty();
        }
        if (response.getStatusCode() != 200) {
            return Result.withError(BidderError.badServerResponse(
                    "Unexpected status code: " + response.getStatusCode()));
        }
{% endif %}
        try {
            final BidResponse bidResponse = mapper.decodeValue(httpCall.getResponse().getBody(), BidResponse.class);
            return Result.withValues(extractBids(bidResponse, bidRequest));
        } catch (DecodeException e) {
            return Result.withError(BidderError.badServerResponse(e.getMessage()));
        }
    }

    private ExtImp{{ ctx.imp_ext_class_root }} parseImpExt(Imp imp) {
