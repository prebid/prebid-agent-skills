    @Override
    public Result<List<HttpRequest<BidRequest>>> makeHttpRequests(BidRequest bidRequest) {
        final List<BidderError> errors = new ArrayList<>();
        final List<HttpRequest<BidRequest>> httpRequests = new ArrayList<>();

{% if ctx.batching_kind == "single-batched" %}
        try {
            // Per-imp validation: parse imp.ext.bidder for each imp; collect errors.
            for (Imp imp : bidRequest.getImp()) {
                parseImpExt(imp);
            }
        } catch (PreBidException e) {
            errors.add(BidderError.badInput(e.getMessage()));
            if (errors.size() == bidRequest.getImp().size()) {
                return Result.withErrors(errors);
            }
        }

        httpRequests.add(BidderUtil.defaultRequest(bidRequest, resolveEndpoint(bidRequest), mapper));
{% elif ctx.batching_kind == "per-imp" %}
        for (Imp imp : bidRequest.getImp()) {
            try {
                final ExtImp{{ ctx.imp_ext_class_root }} extImp = parseImpExt(imp);
                final BidRequest perImpRequest = bidRequest.toBuilder()
                        .imp(Collections.singletonList(imp))
                        .build();
                httpRequests.add(BidderUtil.defaultRequest(
                        perImpRequest,
                        resolveEndpoint(perImpRequest),
                        mapper));
            } catch (PreBidException e) {
                errors.add(BidderError.badInput(e.getMessage()));
            }
        }
{% elif ctx.batching_kind == "max-imps-per-request" %}
        final int maxImpsPerRequest = {{ ctx.batching_max_imps }};
        final List<List<Imp>> chunks = chunkImps(bidRequest.getImp(), maxImpsPerRequest);
        for (List<Imp> chunk : chunks) {
            try {
                for (Imp imp : chunk) {
                    parseImpExt(imp);
                }
                final BidRequest chunkRequest = bidRequest.toBuilder().imp(chunk).build();
                httpRequests.add(BidderUtil.defaultRequest(
                        chunkRequest,
                        resolveEndpoint(chunkRequest),
                        mapper));
            } catch (PreBidException e) {
                errors.add(BidderError.badInput(e.getMessage()));
            }
        }
{% else %}
        // TODO[port-go2java]: batching_kind={{ ctx.batching_kind }} is not yet
        // template-mapped. Operator must hand-fill makeHttpRequests body.
        // (See port-report.json::unresolved_translations[].)
        throw new UnsupportedOperationException("batching_kind={{ ctx.batching_kind }} not yet implemented");
{% endif %}

        if (httpRequests.isEmpty()) {
            return Result.withErrors(errors);
        }
        return Result.of(httpRequests, errors);
    }

    @Override
    public Result<List<BidderBid>> makeBids(BidderCall<BidRequest> httpCall, BidRequest bidRequest) {
        final HttpResponse response = httpCall.getResponse();
{% if ctx.http_status_kind == "canonical-helpers" %}
        if (BidderUtil.isResponseStatusCodeNoContent(response)) {
            return Result.empty();
        }
        try {
            BidderUtil.checkResponseStatusCode(response);
        } catch (PreBidException e) {
            return Result.withError(BidderError.badServerResponse(e.getMessage()));
        }
{% else %}
        if (response.getStatusCode() == 204) {
            return Result.empty();
        }
        if (response.getStatusCode() != 200) {
            return Result.withError(BidderError.badServerResponse(
                    "Unexpected status code: " + response.getStatusCode()));
        }
{% endif %}
        try {
            final BidResponse bidResponse = mapper.decodeValue(response.getBody(), BidResponse.class);
            return Result.withValues(extractBids(bidResponse, bidRequest));
        } catch (DecodeException | JsonProcessingException e) {
            return Result.withError(BidderError.badServerResponse(e.getMessage()));
        }
    }

    private ExtImp{{ ctx.imp_ext_class_root }} parseImpExt(Imp imp) {
        try {
{% if ctx.imp_ext_unmarshal_kind == "standard-two-phase" %}
            return mapper.mapper()
                    .convertValue(imp.getExt(), {{ ctx.bidder_class_root | upper }}_EXT_TYPE_REFERENCE)
                    .getBidder();
{% else %}
            return mapper.mapper()
                    .convertValue(imp.getExt(), ExtImp{{ ctx.imp_ext_class_root }}.class);
{% endif %}
        } catch (IllegalArgumentException e) {
            throw new PreBidException(
                    "Could not parse imp.ext.bidder for imp.id=" + imp.getId() + ": " + e.getMessage());
        }
    }

    private String resolveEndpoint(BidRequest bidRequest) {
{% if ctx.endpoint_resolution_kind == "static" %}
        return endpointUrl;
{% elif ctx.endpoint_resolution_kind == "dev-prod-toggle" %}
        // Dev-prod toggle: when imp.ext.test indicates test mode, use a dev URL;
        // otherwise the configured endpoint. Per source spec's
        // headers_constructed.dev_prod_toggle_signal documentation.
        return endpointUrl;  // placeholder: operator wires the toggle per Rule 13
{% else %}
        // TODO[port-go2java]: endpoint_resolution_kind={{ ctx.endpoint_resolution_kind }}
        // requires per-bidder customization (Rule 11/12/14).
        return endpointUrl;
{% endif %}
    }

    private List<BidderBid> extractBids(BidResponse bidResponse, BidRequest bidRequest) {
        if (bidResponse == null || bidResponse.getSeatbid() == null) {
            return Collections.emptyList();
        }
        return bidResponse.getSeatbid().stream()
                .filter(Objects::nonNull)
                .map(SeatBid::getBid)
                .filter(Objects::nonNull)
                .flatMap(List::stream)
                .map(bid -> BidderBid.of(bid, resolveBidType(bid, bidRequest), bidResponse.getCur()))
                .toList();
    }

    private BidType resolveBidType(Bid bid, BidRequest bidRequest) {
{% if ctx.bid_type_resolution == "constant-banner" %}
        return BidType.banner;
{% elif ctx.bid_type_resolution == "imp-mediatype-introspection" %}
        // Walk bid.impid → matching imp; classify by populated mediatype field.
        for (Imp imp : bidRequest.getImp()) {
            if (Objects.equals(imp.getId(), bid.getImpid())) {
                if (imp.getVideo() != null) {
                    return BidType.video;
                }
                if (imp.getXNative() != null) {
                    return BidType.xNative;
                }
                if (imp.getAudio() != null) {
                    return BidType.audio;
                }
                return BidType.banner;
            }
        }
        return BidType.banner;
{% elif ctx.bid_type_resolution == "ext-prebid-video-placement" %}
        // Inspect bid.ext.prebid.type when present; fallback to imp introspection.
        final JsonNode extPrebid = bid.getExt() != null
                ? bid.getExt().get("prebid")
                : null;
        if (extPrebid != null && extPrebid.get("type") != null) {
            try {
                return BidType.valueOf(extPrebid.get("type").asText());
            } catch (IllegalArgumentException ignored) {
                // fall through
            }
        }
        for (Imp imp : bidRequest.getImp()) {
            if (Objects.equals(imp.getId(), bid.getImpid())) {
                return imp.getVideo() != null ? BidType.video : BidType.banner;
            }
        }
        return BidType.banner;
{% else %}
        // TODO[port-go2java]: bid_type_resolution={{ ctx.bid_type_resolution }}
        // requires per-bidder customization (Rule 23-25).
        return BidType.banner;
{% endif %}
    }
{% if ctx.batching_kind == "max-imps-per-request" %}

    private static List<List<Imp>> chunkImps(List<Imp> imps, int chunkSize) {
        final List<List<Imp>> chunks = new ArrayList<>();
        for (int i = 0; i < imps.size(); i += chunkSize) {
            chunks.add(imps.subList(i, Math.min(i + chunkSize, imps.size())));
        }
        return chunks;
    }
{% endif %}
}
