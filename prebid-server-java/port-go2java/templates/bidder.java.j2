public class {{ ctx.bidder_class_root }}Bidder implements Bidder<BidRequest> {

    private static final TypeReference<ExtPrebid<?, ExtImp{{ ctx.imp_ext_class_root }}>> {{ ctx.bidder_class_root | upper }}_EXT_TYPE_REFERENCE =
            new TypeReference<>() {
            };

    private final String endpointUrl;
{% if ctx.uses_currency_conversion %}
    private final CurrencyConversionService currencyConversionService;
{% endif %}
    private final JacksonMapper mapper;

    public {{ ctx.bidder_class_root }}Bidder(
            String endpointUrl,
{% if ctx.uses_currency_conversion %}
            CurrencyConversionService currencyConversionService,
{% endif %}
            JacksonMapper mapper) {

        this.endpointUrl = HttpUtil.validateUrl(Objects.requireNonNull(endpointUrl));
{% if ctx.uses_currency_conversion %}
