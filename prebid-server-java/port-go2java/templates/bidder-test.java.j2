    private static BidRequest givenBidRequest(UnaryOperator<Imp.ImpBuilder> impCustomizer) {
        return BidRequest.builder()
                .imp(List.of(impCustomizer.apply(Imp.builder().id("imp-1")
                        .ext(jacksonMapper.mapper().valueToTree(
                                ExtPrebid.of(null, ExtImp{{ ctx.imp_ext_class_root }}.of(
                                        {{ ctx.imp_ext_field_pairs | map(attribute='default_value') | join(', ') }}))))).build()))
                .build();
    }

    private static BidderCall<BidRequest> givenHttpCall(int statusCode, String body) {
        final HttpRequest<BidRequest> request = HttpRequest.<BidRequest>builder()
                .uri(ENDPOINT_URL)
                .body(new byte[0])
                .build();
        final HttpResponse response = HttpResponse.of(statusCode, null, body);
        return BidderCall.succeededHttp(request, response, null);
    }
