{% if _endpoint_needs_macros_resolution %}
{# F-new-2 / F-new-27: template-macro + multi-token-substitution real bodies.
   Adapter parses cfg.Endpoint as a text/template at Builder time; here we
   re-parse the first imp's ext (the per-imp ext is needed for the macro
   values), build an EndpointTemplateParams from ctx.endpoint_macros, and
   call macros.ResolveMacros. Pattern cribbed from upstream
   adapters/adkernelAdn/adkernelAdn.go::buildEndpointURL (single macro,
   single canary) + adapters/adverxo/adverxo.go::buildEndpointURL
   (multi-token, two macros) + adapters/thetradedesk/thetradedesk.go::
   buildEndpointURL (single macro string-typed).

   The function flips to a (string, error) return — Builder's template.Parse
   already guarantees the template compiles, but ResolveMacros can still
   error on template evaluation (e.g. missing-field reference); operator
   handling is to bubble the error up to MakeRequests' errors slice.

   When ctx.endpoint_macros is empty / None, the params struct is empty —
   operator gets the full wiring (struct field, Builder Parse, imports)
   without macro values, and a TODO comment points them at the
   ctx.endpoint_macros schema. Useful for the spec-emit pre-pass before
   the operator has populated macros_used. #}
func (a *adapter) resolveEndpoint(request *openrtb2.BidRequest) (string, error) {
	if len(request.Imp) == 0 {
		return "", fmt.Errorf("no imp to resolve endpoint")
	}
{% if _endpoint_macros_list | length > 0 %}
	impExt, err := parseImpExt(&request.Imp[0])
	if err != nil {
		return "", fmt.Errorf("imp %s: failed reading imp.ext for endpoint macros: %w", request.Imp[0].ID, err)
	}
	endpointParams := macros.EndpointTemplateParams{
{% for m in _endpoint_macros_list %}
{% if m.convert == "itoa" %}
		{{ m.macro }}: strconv.Itoa(impExt.{{ m.ext_field }}),
{% elif m.convert == "format-int64" %}
		{{ m.macro }}: strconv.FormatInt(impExt.{{ m.ext_field }}, 10),
{% elif m.convert %}
		{{ m.macro }}: {{ m.convert }},
{% else %}
		{{ m.macro }}: impExt.{{ m.ext_field }},
{% endif %}
{% endfor %}
	}
{% else %}
	// TODO[port-java2go]: ctx.endpoint_macros is empty — operator populates
	// the per-macro mapping per endpoint_resolution.macros_used /
	// macro_field_set from the source spec. Each entry maps a
	// macros.EndpointTemplateParams field to a Go expression on impExt
	// (parsed via parseImpExt(&request.Imp[0]) when ctx populated).
	endpointParams := macros.EndpointTemplateParams{}
{% endif %}
	return macros.ResolveMacros(a.EndpointTemplate, endpointParams)
}
{% else %}
func (a *adapter) resolveEndpoint(request *openrtb2.BidRequest) string {
{% if ctx.endpoint_resolution_kind == "static" %}
	return a.endpoint
{% elif ctx.endpoint_resolution_kind == "dev-prod-toggle" %}
	// Dev-prod toggle: when imp.ext.test (or similar) signals test mode,
