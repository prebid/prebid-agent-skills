	return a.endpoint
{% else %}
	// TODO[port-java2go]: endpoint_resolution_kind={{ ctx.endpoint_resolution_kind }}
	// requires per-bidder customization (Rule 11/12/14).
	return a.endpoint
{% endif %}
}
