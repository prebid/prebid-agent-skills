{# Go {bidder}.go template — emits adapters/{bidder}/{bidder}.go

The main Go adapter file. Implements the adapters.Bidder interface
(Builder + MakeRequests + MakeBids). Mirror of the Java
bidder.java.j2 template's conditional matrix, with Go-specific idiom:

- Explicit `http.Header` headers (Rule 19 inverse — Java helper expansion)
- Explicit `adapters.IsResponseStatusCodeNoContent` + `CheckResponseStatusCodeForErrors`
  helpers (Rule 30 inverse — Java framework-default expansion)
- Composite literals instead of Lombok @Builder (Rule 8 inverse)
- `jsonutil.Marshal` / `Unmarshal` instead of JacksonMapper

The post-emit `gofmt -s -w` step canonicalizes formatting; this
template emits code that's already gofmt-clean for the canonical case.

Inputs (mirror of bidder.java.j2 ctx):
  ctx.package_name            : str  — Go package name (e.g., "kobler", "adkernelAdn").
                                        DEPRECATED-but-supported in favour of
                                        ctx.naming_form_resolution.go_package_name
                                        (F-new-34). When both are present, the
                                        naming_form_resolution form wins; when only
                                        package_name is present (backward-compat),
                                        it is used directly. Tests pass either.
  ctx.bidder_class_root       : str  — PascalCase root used in Builder + helpers.
                                        Same DEPRECATED/preferred-from-
                                        naming_form_resolution.go_constant_root
                                        semantics as ctx.package_name (F-new-34).
  ctx.naming_form_resolution  : dict|null — F-new-34 per-aspect naming-form table
                                        (Rule 46 multi-form-aware naming sites).
                                        Populated by
                                        `scripts.lib.port_engine.lookup_forms(yaml_name)`
                                        at Step 4 ctx-assembly time; the renderer
                                        prefers these forms over ctx.package_name /
                                        ctx.bidder_class_root / ctx.imp_ext_class_root
                                        whenever the dict is provided. Keys (all str):
                                          - go_yaml_name     — `static/bidder-info/{x}.yaml`
                                              + adapter directory (rarely diverges from
                                              go_package_name; cadent_aperture_mx is the
                                              one MVP-corpus example).
                                          - go_package_name  — `package X` directive
                                              and the EndpointTemplate name prefix.
                                              This template references THIS form
                                              everywhere ctx.package_name is used today.
                                          - go_constant_root — `openrtb_ext.Bidder{X}`
                                              constant suffix. Used by sibling templates
                                              (params_test.go.j2, bidder-test.go.j2) —
                                              this template does not emit it directly.
                                          - java_yaml_name   — Java-side `bidder-config/{x}.yaml`
                                              name. Used by go2java sibling templates;
                                              not consumed by this Go-side template.
                                          - java_class_root  — Java-side `{X}Bidder` class
                                              root. Not consumed by this template.
                                          - java_package     — Java-side
                                              `org.prebid.server.bidder.{x}` package.
                                              Not consumed by this template.
                                        When the dict is absent, the template falls
                                        back to ctx.package_name / ctx.imp_ext_class_root
                                        (backward-compat with pre-F-new-34 ctx shape).
                                        Affects 6 corpus pairs (adkernelAdn, thetradedesk,
                                        audienceNetwork, cadent_aperture_mx, stroeerCore,
                                        sspBC) where the Go yaml/package and Java yaml
                                        diverge non-mechanically.
  ctx.uses_currency_conversion: bool — currency_conversion.used (Rule 28).
                                        When true, emits (a) a `convertImpCurrency`
                                        helper at end of file (modeled on upstream
                                        kobler.go ~lines 149-161, hardcoded
                                        supportedCurrency="USD"), (b) a `"strings"`
                                        import for `strings.ToUpper`, and (c) a
                                        per-imp call to convertImpCurrency BEFORE
                                        parseImpExt in all three batching branches
                                        (single-batched, per-imp, max-imps-per-request).
                                        On conversion error the call site appends
                                        to errors and `continue`s — safer default
                                        than upstream kobler's hard-return; operator
                                        can flip if they want kobler-strict semantics.
                                        Affects ~31% of corpus (adverxo, beachfront,
                                        kobler, limelightDigital, vungle).
  ctx.imp_ext_class_root      : str  — for openrtb_ext.ExtImp{X} type ref.
                                        DEPRECATED-but-supported in favour of
                                        ctx.naming_form_resolution.go_constant_root
                                        (F-new-34). The Go convention is that
                                        ExtImp{X}'s X matches the bidder constant
                                        root (e.g. `ExtImpAdkernelAdn` paired with
                                        `BidderAdkernelAdn`); when
                                        naming_form_resolution is provided, the
                                        go_constant_root form is used unless
                                        ctx.imp_ext_class_root is ALSO explicitly
                                        set (the explicit override wins for the
                                        rare bidder whose ExtImp class diverges
                                        from its constant root).
  ctx.imp_ext_unmarshal_kind  : str  — "standard-two-phase" | "direct" | "none".
                                        "none" (~12% corpus: aax, optidigital)
                                        skips both the per-imp parseImpExt() call
                                        from each batching branch's per-imp loop
                                        AND the parseImpExt helper function
                                        entirely. Used when imp.ext.bidder has no
                                        required fields and the adapter forwards
                                        the request without imp.ext inspection.
  ctx.batching_kind           : str  — "single-batched" | "per-imp" | "max-imps-per-request"
                                        | "format-split" | "pod-grouping"
  ctx.batching_max_imps       : int|null
  ctx.endpoint_resolution_kind: str  — "static" | "single-token-substitution" |
                                        "query-parameter-augmentation" | "dev-prod-toggle"
                                        | "template-macro" | "multi-token-substitution"
  ctx.endpoint_macros         : list[{macro: str, ext_field: str, convert: str|None}] |
                                        None — REQUIRED when
                                        endpoint_resolution_kind ∈
                                        {"template-macro", "multi-token-substitution"}.
                                        Each entry maps one Go `macros.EndpointTemplateParams`
                                        field to a Go expression read off the parsed ImpExt
                                        struct. Keys:
                                          - macro: str — canonical `EndpointTemplateParams`
                                              field name (e.g. "PublisherID", "SupplyId",
                                              "AdUnit", "TokenID"). See
                                              prebid-server/macros/macros.go for the full
                                              accepted set; unrecognized values still emit
                                              but produce a Go compile error caught by the
                                              `gofmt`/`go vet` post-process gate.
                                          - ext_field: str — exact PascalCase field name on
                                              the rendered `openrtb_ext.ExtImp{X}` struct
                                              (e.g. "PublisherID", "Auth", "AdUnitId").
                                              Template references this via `impExt.{ext_field}`.
                                          - convert: str|None — value-conversion wrapper.
                                              None / omitted → emit raw `impExt.{ext_field}`
                                              (assumes string type). "itoa" → wrap with
                                              `strconv.Itoa(impExt.{ext_field})` (int → string;
                                              caller MUST add `"strconv"` to imports_extra).
                                              "format-int64" → `strconv.FormatInt(impExt.{ext_field}, 10)`.
                                              Other values pass through literally as the
                                              full Go expression (escape hatch for unusual
                                              conversions; operator vouches it compiles).
                                        When endpoint_resolution_kind is
                                        "template-macro" or "multi-token-substitution",
                                        the template:
                                          (a) adds the `EndpointTemplate *template.Template`
                                              field to the adapter struct;
                                          (b) parses `cfg.Endpoint` via `text/template`
                                              at Builder time, returning fmt.Errorf on
                                              parse failure;
                                          (c) imports `"text/template"` +
                                              `"github.com/prebid/prebid-server/{v}/macros"`;
                                          (d) emits a resolveEndpoint that returns
                                              `(string, error)`, parses the first imp's
                                              ext, builds an `EndpointTemplateParams`
                                              from `endpoint_macros`, and calls
                                              `macros.ResolveMacros(...)` (mirrors upstream
                                              adkernelAdn.go::buildEndpointURL +
                                              adverxo.go::buildEndpointURL);
                                          (e) updates all 3 MakeRequests callsites to
                                              handle the error from resolveEndpoint
                                              (single-batched / per-imp / max-imps).
                                        When the list is empty or None, an empty
                                        `EndpointTemplateParams{}` struct emits and the
                                        template body short-circuits with a TODO comment
                                        — useful for operator pre-emit (just the wiring,
                                        no macro values yet).
                                        Affects ~19% of corpus (adkernelAdn, adverxo,
                                        thetradedesk + others under analysis).
  ctx.http_status_kind        : str  — "canonical-helpers" | "legacy-raw" |
                                        "legacy-raw-go". The "legacy-raw-go"
                                        variant emits the same baseline 204+200
                                        check as "legacy-raw" but additionally
                                        consumes ctx.legacy_raw_status_handlers
                                        for per-status branching (see below).
  ctx.legacy_raw_status_handlers : list[{status_code: int, error_kind: str}] |
                                        None — Per-status branches inserted
                                        between the 204 short-circuit and the
                                        generic non-200 catchall. Each entry
                                        emits one
                                        `if responseData.StatusCode == http.StatusXxx { ... &errortypes.{error_kind}{...} }`
                                        block in declared order. Common shape
                                        (aax): `[{status_code: 400, error_kind:
                                        "BadInput"}]` produces the 400→BadInput
                                        branch; the existing non-200 fallthrough
                                        becomes BadServerResponse. Only consulted
                                        when http_status_kind=="legacy-raw-go";
                                        ignored otherwise. None / [] preserves
                                        the original 2-branch (204 / non-200
                                        generic) behavior for back-compat.
                                        Affects ~3/16 (19%) of corpus.
                                        Status-code constants use http.StatusXxx
                                        Go names when canonical (StatusBadRequest=
                                        400, StatusOK=200, StatusNoContent=204,
                                        StatusNotFound=404, etc.); non-canonical
                                        codes fall back to integer literals.
  ctx.bid_type_resolution     : str  — discriminator. One of:
                                          "imp-mediatype-introspection",
                                          "constant" (or legacy alias "constant-banner"),
                                          "method-chain-fallback",
                                          "by-bid-mtype",
                                          "by-bid-ext-typed-field".
                                          (Reviewer H6 correction: removed
                                          "ext-prebid-video-placement" — listed
                                          but no template branch implements it,
                                          and no audit pair uses it. Add the
                                          enum value back together with a
                                          template branch when a real bidder
                                          surfaces this pattern.)
  ctx.bid_type_constant       : str|None — "banner"|"video"|"audio"|"native". REQUIRED
                                            when bid_type_resolution=="constant". For
                                            backwards compat, legacy "constant-banner"
                                            implies bid_type_constant="banner".
  ctx.bid_type_method_chain   : list|None — REQUIRED when
                                            bid_type_resolution=="method-chain-fallback".
                                            Each step is a dict with keys:
                                              - method: str — one of
                                                  "by-bid-ext-typed-field",
                                                  "by-imp-mediatype",
                                                  "by-request-uri-suffix",
                                                  "hardcoded",
                                                  "throw"
                                              - field: str|None — JSON path the step
                                                  reads (e.g. "bid.ext.prebid.type")
                                              - hardcoded_value: str|None — for
                                                  method=="hardcoded", canonical Go enum
                                                  name (e.g. "BidTypeBanner")
                                              - fallback_action: str — "next" |
                                                  "return-default" | "throw"
  ctx.bid_type_ext_field      : dict|None — REQUIRED when
                                            bid_type_resolution=="by-bid-ext-typed-field"
                                            (single-step throws). Keys:
                                              - struct_name: str — the typed wrapper Go
                                                  struct already defined (e.g. "bidExt")
                                              - field_path: str — Go expression that
                                                  yields the string value to parse, in
                                                  scope where `bidExt` is the unmarshaled
                                                  struct (e.g. "bidExt.MediaType",
                                                  "bidExt.Appnexus.BidType")
                                              - parse_via: str — "openrtb_ext.ParseBidType"
                                                  (string fields) or "switch-int" (numeric
                                                  fields, requires `int_cases` mapping).
                                              - int_cases: list[dict]|None — when
                                                  parse_via=="switch-int", each entry is
                                                  {value: int, bid_type: "banner"|...}.
  ctx.bid_type_fallback_action: str|None — for "by-bid-mtype" branch. One of
                                            "return-default" or "throw".
  ctx.bid_type_fallback_value : str|None — when fallback_action=="return-default",
                                            "banner"|"video"|"audio"|"native".
  ctx.has_extra_info          : bool — true when source has ExtraAdapterInfo (Rule 35
                                        inverse demoted Java typed config to Go opaque
                                        JSON string); imports + struct fields adjust.
  ctx.module_version          : str  — Go module major version per upstream go.mod
                                        (current "v4"; v3→v4 PR #4710 merged 2026-03-05).
                                        See bidder-constant-table.yaml::upstream_source.module_version
                                        for the canonical pin.
  ctx.imports_extra           : list[str] — caller-collected; one fully-qualified import
                                            per entry; alphabetical.
  ctx.custom_headers          : list[{name: str, value: str}] | None — extra headers
                                            beyond the universal Content-Type +
                                            Accept pair, appended inside
                                            standardHeaders(). None or [] → no extras
                                            emitted (preserves the kobler-shape
                                            two-header baseline). Each entry produces
                                            one `headers.Add({{name}}, {{value}})`
                                            line in declaration order.
                                            Header NAMES SHOULD be passed in canonical
                                            mixed-case (e.g., "X-OpenRTB-Version", not
                                            "x-openrtb-version"). The template emits
                                            literally what the spec provides via the
                                            tojson filter; per-spec normalization is a
                                            spec-hygiene concern (audit F-new-6 noted
                                            Go-side specs sometimes carried lowercase
                                            forms — fix at the spec layer, not here).
                                            Affects ~31% of corpus (adkernelAdn,
                                            elementaltv, freewheelssp, smarthub,
                                            vungle).
  ctx.javadoc_summary         : str|null — // doc comment above package var or struct
#}
{# ---------------- Internal helpers (bid type resolution) ---------------- #}
{# Map a short bid-type string ("banner"|"video"|"audio"|"native") to the
   canonical Go openrtb_ext enum literal. Fail loudly when the input is not
   one of the four supported short forms — caller passed a value the Go
   side has no symbol for, and silently emitting `BidTypeOther` would make
   the broken Go code look correct at render time. #}
{%- set _bid_type_short_to_go = {
    "banner": "BidTypeBanner",
    "video":  "BidTypeVideo",
    "audio":  "BidTypeAudio",
    "native": "BidTypeNative",
} -%}
{# Decide whether getBidType returns (BidType, error). True iff a "throw"
   fallback exists anywhere in the resolution shape. Computed once so the
   function declaration AND the MakeBids caller site stay in sync. #}
{%- set _bid_type_chain = ctx.bid_type_method_chain or [] -%}
{%- set _chain_has_throw = _bid_type_chain | selectattr("fallback_action", "equalto", "throw") | list | length > 0 -%}
{%- set _chain_has_throw_method = _bid_type_chain | selectattr("method", "equalto", "throw") | list | length > 0 -%}
{%- set _bid_type_returns_error = (
    ctx.bid_type_resolution == "by-bid-ext-typed-field"
    or (ctx.bid_type_resolution == "by-bid-mtype" and ctx.bid_type_fallback_action == "throw")
    or (ctx.bid_type_resolution == "method-chain-fallback" and (_chain_has_throw or _chain_has_throw_method))
) -%}
{# Inline suffix appended after a successful BidType return. Empty for the
   no-error signature; ", nil" for the error-returning signature. Used as
   a plain string substitution so adjacent newlines don't get eaten by
   trim_blocks=True. #}
{%- if _bid_type_returns_error -%}
{%- set _ok_suffix = ", nil" -%}
{%- else -%}
{%- set _ok_suffix = "" -%}
{%- endif -%}
{# F-new-2 / F-new-27: endpoint_resolution_kind ∈ {template-macro,
   multi-token-substitution} triggers the macros.ResolveMacros emission
   branch. Adapter struct gains EndpointTemplate, Builder parses the
   template once, resolveEndpoint flips to a (string, error) return and
   3 callsites bind err → errors. Single predicate computed up-front so
   import block / struct emit / signature emit / callsites stay in sync. #}
{%- set _endpoint_needs_macros_resolution = (
    ctx.endpoint_resolution_kind == "template-macro"
    or ctx.endpoint_resolution_kind == "multi-token-substitution"
) -%}
{%- set _endpoint_macros_list = ctx.endpoint_macros or [] -%}
{# F-new-1: imp_ext_unmarshal_kind=="none" skips both the per-imp call AND
   the parseImpExt helper. Compute once so call sites + helper definition
   stay in sync. F-new-2: when macros-resolution is active the parseImpExt
   helper is required regardless (resolveEndpoint re-parses imp[0].ext to
   read macro source fields), so force-enable it. #}
{%- set _emit_parse_imp_ext = (
    ctx.imp_ext_unmarshal_kind != "none"
    or _endpoint_needs_macros_resolution
) -%}
{# F-new-1 partner: when neither currency-conversion nor parseImpExt has any
   per-imp work to do, the single-batched / max-imps inner loops collapse to
   an empty body. Drop the loop entirely (Go lints empty loops; upstream
   aax.go has no per-imp loop at all in MakeRequests). #}
{%- set _has_per_imp_work = ctx.uses_currency_conversion or _emit_parse_imp_ext -%}
{# F-new-14: legacy-raw-go per-status handlers schema. None / [] means
   back-compat (existing 2-branch shape). Populated list means emit per-status
   branches BEFORE the generic non-200 catchall — and the catchall flips from
   `fmt.Errorf` to `&errortypes.BadServerResponse{}` (matches upstream aax). #}
{%- set _legacy_raw_handlers = ctx.legacy_raw_status_handlers or [] -%}
{%- set _legacy_raw_go_with_handlers = (
    ctx.http_status_kind == "legacy-raw-go" and (_legacy_raw_handlers | length > 0)
) -%}
{# Map a small set of common status codes to their canonical net/http
   constant names. Codes outside this set fall back to integer literals
   in the emitted Go (still compiles; just less idiomatic). #}
{%- set _http_status_const_map = {
    200: "http.StatusOK",
    204: "http.StatusNoContent",
    400: "http.StatusBadRequest",
    401: "http.StatusUnauthorized",
    403: "http.StatusForbidden",
    404: "http.StatusNotFound",
    408: "http.StatusRequestTimeout",
    429: "http.StatusTooManyRequests",
    500: "http.StatusInternalServerError",
    502: "http.StatusBadGateway",
    503: "http.StatusServiceUnavailable",
    504: "http.StatusGatewayTimeout",
} -%}
{# F-new-34: naming-form-resolution. When ctx.naming_form_resolution is
   provided (Step 4 ctx-assembly calls
   `scripts.lib.port_engine.lookup_forms(yaml_name)`), each form key
   wins over the legacy single-form ctx keys (ctx.package_name,
   ctx.imp_ext_class_root). Explicit ctx-key overrides still win when
   set (the rare ExtImp-vs-constant divergence case). When the dict is
   absent, legacy keys flow through unchanged (pre-F-new-34 ctx shape). #}
{%- set _forms = ctx.naming_form_resolution or {} -%}
{%- set _go_package_name = _forms.get('go_package_name') or ctx.package_name -%}
{%- set _imp_ext_class_root = ctx.imp_ext_class_root or _forms.get('go_constant_root') -%}
package {{ _go_package_name }}

import (
{% if ctx.has_extra_info %}
	"encoding/json"
{% endif %}
	"fmt"
	"net/http"
{% if ctx.uses_currency_conversion %}
	"strings"
{% endif %}
{% if _endpoint_needs_macros_resolution %}
	"text/template"
{% endif %}

	"github.com/prebid/openrtb/v20/openrtb2"
	"github.com/prebid/prebid-server/{{ ctx.module_version }}/adapters"
	"github.com/prebid/prebid-server/{{ ctx.module_version }}/config"
{% if _legacy_raw_go_with_handlers %}
	"github.com/prebid/prebid-server/{{ ctx.module_version }}/errortypes"
{% endif %}
{% if _endpoint_needs_macros_resolution %}
	"github.com/prebid/prebid-server/{{ ctx.module_version }}/macros"
{% endif %}
	"github.com/prebid/prebid-server/{{ ctx.module_version }}/openrtb_ext"
	"github.com/prebid/prebid-server/{{ ctx.module_version }}/util/jsonutil"
{% for imp in ctx.imports_extra %}
	"{{ imp }}"
{% endfor %}
)

{% if ctx.javadoc_summary %}
// {{ ctx.javadoc_summary }}
{% endif %}
type adapter struct {
	endpoint string
{% if _endpoint_needs_macros_resolution %}
	EndpointTemplate *template.Template
{% endif %}
{% if ctx.has_extra_info %}
	extraInfo extraInfo
{% endif %}
}

{% if ctx.has_extra_info %}
type extraInfo struct {
	// TODO[port-java2go]: operator fills fields from the Java typed-config
	// subclass per Rule 35 inverse. Each Java field becomes a Go field with
	// `json:"X"` tag matching the upstream YAML key.
}

{% endif %}
func Builder(_ openrtb_ext.BidderName, cfg config.Adapter, _ config.Server) (adapters.Bidder, error) {
	a := &adapter{endpoint: cfg.Endpoint}
{% if _endpoint_needs_macros_resolution %}
	tpl, err := template.New("{{ _go_package_name }}EndpointTemplate").Parse(cfg.Endpoint)
	if err != nil {
		return nil, fmt.Errorf("unable to parse endpoint url template: %v", err)
	}
	a.EndpointTemplate = tpl
{% endif %}
{% if ctx.has_extra_info %}
	if cfg.ExtraAdapterInfo != "" {
		if err := json.Unmarshal([]byte(cfg.ExtraAdapterInfo), &a.extraInfo); err != nil {
			return nil, fmt.Errorf("invalid extra info: %w", err)
		}
	}
{% endif %}
	return a, nil
}

func (a *adapter) MakeRequests(request *openrtb2.BidRequest, reqInfo *adapters.ExtraRequestInfo) ([]*adapters.RequestData, []error) {
	var errors []error
{% if ctx.batching_kind == "single-batched" %}
{% if _has_per_imp_work %}
	for i := range request.Imp {
{% if ctx.uses_currency_conversion %}
		if err := convertImpCurrency(&request.Imp[i], reqInfo); err != nil {
			errors = append(errors, err)
			continue
		}
{% endif %}
{% if _emit_parse_imp_ext %}
		if _, err := parseImpExt(&request.Imp[i]); err != nil {
			errors = append(errors, err)
		}
{% endif %}
	}

{% endif %}
	body, err := jsonutil.Marshal(request)
	if err != nil {
		return nil, append(errors, err)
	}

{% if _endpoint_needs_macros_resolution %}
	uri, err := a.resolveEndpoint(request)
	if err != nil {
		return nil, append(errors, err)
	}
	return []*adapters.RequestData{
		{
			Method:  http.MethodPost,
			Uri:     uri,
			Body:    body,
			Headers: standardHeaders(),
			ImpIDs:  openrtb_ext.GetImpIDs(request.Imp),
		},
	}, errors
{% else %}
	return []*adapters.RequestData{
		{
			Method:  http.MethodPost,
			Uri:     a.resolveEndpoint(request),
			Body:    body,
			Headers: standardHeaders(),
			ImpIDs:  openrtb_ext.GetImpIDs(request.Imp),
		},
	}, errors
{% endif %}
{% elif ctx.batching_kind == "per-imp" %}
	requests := make([]*adapters.RequestData, 0, len(request.Imp))
	for i := range request.Imp {
{% if ctx.uses_currency_conversion %}
		if err := convertImpCurrency(&request.Imp[i], reqInfo); err != nil {
			errors = append(errors, err)
			continue
		}
{% endif %}
{% if _emit_parse_imp_ext %}
		if _, err := parseImpExt(&request.Imp[i]); err != nil {
			errors = append(errors, err)
			continue
		}
{% endif %}
		perImp := *request
		perImp.Imp = []openrtb2.Imp{request.Imp[i]}
		body, err := jsonutil.Marshal(&perImp)
		if err != nil {
			errors = append(errors, err)
			continue
		}
{% if _endpoint_needs_macros_resolution %}
		uri, err := a.resolveEndpoint(&perImp)
		if err != nil {
			errors = append(errors, err)
			continue
		}
		requests = append(requests, &adapters.RequestData{
			Method:  http.MethodPost,
			Uri:     uri,
			Body:    body,
			Headers: standardHeaders(),
			ImpIDs:  openrtb_ext.GetImpIDs(perImp.Imp),
		})
{% else %}
		requests = append(requests, &adapters.RequestData{
			Method:  http.MethodPost,
			Uri:     a.resolveEndpoint(&perImp),
			Body:    body,
			Headers: standardHeaders(),
			ImpIDs:  openrtb_ext.GetImpIDs(perImp.Imp),
		})
{% endif %}
	}
	return requests, errors
{% elif ctx.batching_kind == "max-imps-per-request" %}
	const maxImpsPerRequest = {{ ctx.batching_max_imps }}
	chunks := chunkImps(request.Imp, maxImpsPerRequest)
	requests := make([]*adapters.RequestData, 0, len(chunks))
	for _, chunk := range chunks {
{% if _has_per_imp_work %}
		for i := range chunk {
{% if ctx.uses_currency_conversion %}
			if err := convertImpCurrency(&chunk[i], reqInfo); err != nil {
				errors = append(errors, err)
				continue
			}
{% endif %}
{% if _emit_parse_imp_ext %}
			if _, err := parseImpExt(&chunk[i]); err != nil {
				errors = append(errors, err)
			}
{% endif %}
		}
{% endif %}
		chunkRequest := *request
		chunkRequest.Imp = chunk
		body, err := jsonutil.Marshal(&chunkRequest)
